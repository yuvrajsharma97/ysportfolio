rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "sharma.yuvraj.ys1@gmail.com";
    }

    // content/socials holds resumeUrl, edited from /admin.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collections from the previous site, kept readable and admin-writable.
    match /{collection}/{docId} {
      allow read: if collection in ['projects', 'experience', 'techStack', 'capabilities'];
      allow write: if isAdmin();
    }
  }
}
