# Copy to .env.local and fill in. .env.local is gitignored.

# EmailJS (https://www.emailjs.com): powers the contact form.
# The template receives user_name, user_email and message.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase: only /admin uses the SDK (to edit the CV link).
# The public page reads content/socials over Firestore's REST API using the project id.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=portfolio-1e442
VITE_FIREBASE_APP_ID=

# The Google account allowed to sign in to /admin. Must match firestore.rules.
VITE_ADMIN_EMAIL=
