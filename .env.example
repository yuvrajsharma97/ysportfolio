# EmailJS (https://www.emailjs.com) — powers the contact form in src/components/Contact.tsx
# Copy this file to .env.local and fill in your own values. .env.local is gitignored (matches *.local).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase (https://console.firebase.google.com) — powers all site content + the /admin panel.
# Project settings → General → "Your apps" → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Google account email allowed to sign in to /admin. Must match the email
# hardcoded in firestore.rules (isAdmin function).
VITE_ADMIN_EMAIL=
